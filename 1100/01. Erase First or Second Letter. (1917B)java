import java.util.*;
public class Main{
  public static void main(String[] args){
    Scanner sc  = new Scanner(System.in);  
    int t = sc.nextInt();
    while(t-->0){
      int n = sc.nextInt();
      String s = sc.next();
      int unique=0;
      int ans=0;
      boolean[] found = new boolean[26];
      for(int i=0;i<n;i++){
        char c = s.charAt(i);
        if(!found[c-'a']) unique++;
        found[c-'a'] = true;
        ans+=unique; 
      }
      System.out.println(ans);
    }
  }
}

